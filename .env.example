# ============================================================
#  المكتبة الإلكترونية — environment variables
#  Copy to `.env.local` (git-ignored) and adjust.
# ============================================================

# --- Admin demo gate (FRONT-END ONLY, not real security) ---
# Used by the local browser CMS login screen. Change these before any
# real deployment, and prefer moving auth to Supabase (see below).
VITE_ADMIN_EMAIL=admin@maktaba.local
VITE_ADMIN_PASSWORD=admin1234

# --- Supabase (optional, for the real backend) ---
# Only the anon (public) key belongs in the frontend. NEVER put the
# service_role key or any secret in VITE_* variables — they ship to the browser.
# VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# --- External file storage (PDF/EPUB): OneDrive + Up-4ever only ---
# Files are NEVER stored in the site/build. The DB keeps only the download URL
# (+ optional OneDrive file id). URL-based storage needs NO key.
#
#   OneDrive  = storage / archive        (provider = "onedrive")
#   Up-4ever  = download + monetisation  (provider = "up4ever")
#
# OPTIONAL — OneDrive "Select from OneDrive" picker via Microsoft Graph.
# These are SERVER-SIDE ONLY (Netlify/Supabase Edge Function) — never VITE_*,
# never in the frontend bundle. Manual OneDrive URLs work without any of this.
# MS_GRAPH_CLIENT_ID=...
# MS_GRAPH_CLIENT_SECRET=...     # server-side function only
# MS_GRAPH_TENANT_ID=...
# MS_GRAPH_REFRESH_TOKEN=...     # server-side function only
#
# Up-4ever: no key needed (admin pastes the real share URL from their account).
# If you add the Up-4ever API later, keep its secret server-side only:
# UP4EVER_API_KEY=...            # server-side function only
